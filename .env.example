# =========================================
# Discipline Society · Environment variables
# =========================================
# Copy to .env for local Netlify development and set the same values in Netlify:
# Site configuration -> Environment variables.
#
# Never commit a real .env file.

# Public site URL, without trailing slash.
SITE_URL=https://disciplinesociety.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx

# Server-side catalog. Use one shared price per product/color, or override
# individual sizes with e.g. STRIPE_HOODIE_S_PRICE_ID.
STRIPE_HOODIE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_TEE_BLACK_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_TEE_SAND_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_TRACKSUIT_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxx

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# Resend (optional)
RESEND_API_KEY=
FROM_EMAIL=Discipline Society <hola@tudominio.com>
ADMIN_EMAIL=tu@email.com
